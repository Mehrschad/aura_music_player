<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Storage / media permissions ── -->
    <!-- Android 13+: granular audio permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- Android ≤12: broad external storage read -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- ── Background audio / foreground service ── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Keep CPU alive during playback when screen is off -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- ── Notifications ── -->
    <!-- Media notification on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ── Network (lyrics fetching) ── -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- ── Hardware feature declaration ── -->
    <!-- Declares this is a media-playback app; shown in Play Store filter -->
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="false"/>

    <!-- Android 11+ package visibility: query media apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON"/>
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService"/>
        </intent>
    </queries>

    <application
        android:label="Aura"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <!-- ── Android Auto ── -->
        <!--
          Declares Aura as an Android Auto media app. Without this meta-data the
          app never appears in Android Auto's launcher even though the
          MediaBrowserService below is present. It points at res/xml/
          automotive_app_desc.xml, which lists <uses name="media"/>.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc"/>
        <!-- Android Auto notification colour for the media card. -->
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_notification"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ── Background audio service (audio_service package) ── -->
        <!--
          foregroundServiceType="mediaPlayback" → Android recognises this as an
          official media player; grants the media session priority.
          stopWithTask="false" → audio keeps playing when app is swiped away.
          exported="true" → required for MediaBrowserServiceCompat (Android Auto,
          WearOS, lock-screen controls).
        -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:label="Aura"
            android:exported="true"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback">
            <!-- MediaBrowserService: enables Android Auto, WearOS, lock screen -->
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- ── Hardware media button receiver ── -->
        <!--
          android:priority="1000" → this app wins media-button dispatch over
          other apps (Bluetooth headset, wired headphone button, car stereo).
          exported="true" → required so the system can deliver the broadcast.
        -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>
